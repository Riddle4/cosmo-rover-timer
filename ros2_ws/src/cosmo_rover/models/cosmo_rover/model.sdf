<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="cosmo_rover">
    <!-- The rover is dynamic, but it has no motor controller yet. -->
    <static>false</static>

    <!-- Main rectangular chassis. It is the parent link for the wheel joints. -->
    <link name="chassis">
      <pose>0 0 0.34 0 0 0</pose>
      <inertial>
        <mass>4.0</mass>
        <inertia>
          <ixx>0.12</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.32</iyy>
          <iyz>0.0</iyz>
          <izz>0.38</izz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <geometry>
          <box>
            <size>0.9 0.55 0.22</size>
          </box>
        </geometry>
      </collision>
      <visual name="chassis_visual">
        <geometry>
          <box>
            <size>0.9 0.55 0.22</size>
          </box>
        </geometry>
        <material>
          <ambient>0.0 0.45 1.0 1</ambient>
          <diffuse>0.0 0.45 1.0 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Each wheel is a cylinder rotated so its axle is along the Y axis. -->
    <link name="front_left_wheel">
      <pose>0.32 0.35 0.18 1.5708 0 0</pose>
      <inertial>
        <mass>0.4</mass>
        <inertia>
          <ixx>0.004</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.004</iyy>
          <iyz>0.0</iyz>
          <izz>0.006</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.18</radius>
            <length>0.12</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.18</radius>
            <length>0.12</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="front_right_wheel">
      <pose>0.32 -0.35 0.18 1.5708 0 0</pose>
      <inertial>
        <mass>0.4</mass>
        <inertia>
          <ixx>0.004</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.004</iyy>
          <iyz>0.0</iyz>
          <izz>0.006</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.18</radius>
            <length>0.12</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.18</radius>
            <length>0.12</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="rear_left_wheel">
      <pose>-0.32 0.35 0.18 1.5708 0 0</pose>
      <inertial>
        <mass>0.4</mass>
        <inertia>
          <ixx>0.004</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.004</iyy>
          <iyz>0.0</iyz>
          <izz>0.006</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.18</radius>
            <length>0.12</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.18</radius>
            <length>0.12</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="rear_right_wheel">
      <pose>-0.32 -0.35 0.18 1.5708 0 0</pose>
      <inertial>
        <mass>0.4</mass>
        <inertia>
          <ixx>0.004</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.004</iyy>
          <iyz>0.0</iyz>
          <izz>0.006</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.18</radius>
            <length>0.12</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.18</radius>
            <length>0.12</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Revolute wheel joints describe the structure without adding control yet. -->
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <joint name="front_right_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>
  </model>
</sdf>
