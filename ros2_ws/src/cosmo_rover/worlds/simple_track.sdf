<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="simple_track">
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.78 0.86 0.95 1</background>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.3 -1</direction>
    </light>

    <model name="flat_ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <box>
              <size>14 10 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <box>
              <size>14 10 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.55 0.35 1</ambient>
            <diffuse>0.35 0.55 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Four low blocks draw a simple rectangular track boundary. -->
    <model name="track_north_line">
      <static>true</static>
      <pose>0 3 0.08 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>10 0.12 0.08</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="track_south_line">
      <static>true</static>
      <pose>0 -3 0.08 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>10 0.12 0.08</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="track_east_line">
      <static>true</static>
      <pose>5 0 0.08 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.12 6 0.08</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="track_west_line">
      <static>true</static>
      <pose>-5 0 0.08 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.12 6 0.08</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="start_line">
      <static>true</static>
      <pose>-4 0 0.1 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.25 5.5 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.1 0.1 1</ambient>
            <diffuse>1 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
